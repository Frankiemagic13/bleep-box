<Window x:Class="BleepBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bleep Box" Width="1100" Height="780" MinWidth="920" MinHeight="700"
        Background="#15171B" Foreground="#E8EAED"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized" Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#1C1F24"/>
            <Setter Property="BorderBrush" Value="#2A2E35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#A3A9B1"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#A3A9B1"/>
            <Setter Property="Margin" Value="0,14,0,6"/>
        </Style>

        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A3A9B1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="18,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF8A3D"/>
                                <Setter Property="Foreground" Value="#15171B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoundBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C9CDD3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="Sound"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="#121418" BorderBrush="#2A2E35" BorderThickness="1"
                                CornerRadius="8" MinHeight="44">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#4A4F57"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#33241A"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#FF8A3D"/>
                                <Setter TargetName="b" Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#FF9A4D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,6">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E8EAED"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8EAED"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Padding="12,8" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A2E35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E8EAED"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#121418" BorderBrush="#343941" BorderThickness="1" CornerRadius="6">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                                  Data="M0,0 L5,5 L10,0" Stroke="#A3A9B1" StrokeThickness="1.6"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="12,0,36,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#1C1F24" BorderBrush="#343941" BorderThickness="1" CornerRadius="6"
                                        MaxHeight="300"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#101215" BorderBrush="#23262C" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="#6B7280" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ConnText" FontSize="12" Foreground="#A3A9B1" Text="Looking for OBS…"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#A3A9B1"
                           Text="Hotkey: Ctrl + Shift + B"/>
            </Grid>
        </Border>

        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- Left column -->
            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Style="{StaticResource Header}" Text="MICROPHONE INPUT"/>
                            <TextBlock x:Name="MicState" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#6B7280" Text="OFFLINE"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Label}" Text="Device"/>
                        <ComboBox x:Name="DeviceCombo" Style="{StaticResource DarkCombo}"
                                  DropDownOpened="DeviceCombo_DropDownOpened"
                                  SelectionChanged="DeviceCombo_SelectionChanged"/>
                        <TextBlock Style="{StaticResource Label}" Text="Level"/>
                        <UniformGrid x:Name="Meter" Columns="30" Rows="1" Height="22"/>
                        <Grid Margin="0,14,0,6">
                            <TextBlock FontSize="13" Foreground="#A3A9B1" Text="Input gain"/>
                            <TextBlock x:Name="GainText" HorizontalAlignment="Right" FontSize="13" Text="100%"/>
                        </Grid>
                        <Slider x:Name="GainSlider" Minimum="0" Maximum="300" Value="100" SmallChange="1" LargeChange="10"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="GainSlider_ValueChanged"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Header}" Text="OBS SOURCE"/>
                        <Border Background="#121418" BorderBrush="#2A2E35" BorderThickness="1" CornerRadius="8"
                                Padding="14,12" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="22" Height="22" Stretch="Uniform" Margin="0,0,12,0"
                                      Stroke="#E8EAED" StrokeThickness="1.6" VerticalAlignment="Center"
                                      Data="M12,3 A3,3 0 0 1 15,6 V11 A3,3 0 0 1 9,11 V6 A3,3 0 0 1 12,3 Z M5,11 A7,7 0 0 0 19,11 M12,18 V21"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold" Text="Bleep Box Mic"/>
                                    <TextBlock FontSize="12" Foreground="#A3A9B1" TextWrapping="Wrap"
                                               Text="In OBS: Sources → + → Bleep Box Mic"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="ObsDot" Width="8" Height="8" Fill="#6B7280" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="ObsText" FontSize="12" Foreground="#A3A9B1" Text="Not found"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <CheckBox x:Name="FullMuteCheck" Content="Mute mic fully while bleeping"
                                  Checked="FullMute_Changed" Unchecked="FullMute_Changed"/>
                        <TextBlock FontSize="12" Foreground="#A3A9B1" TextWrapping="Wrap" Margin="0,14,0,0"
                                   Text="To hear the bleep yourself: OBS → Edit → Advanced Audio Properties → Bleep Box Mic → Monitor and Output."/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right column -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="24" VerticalAlignment="Top">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Bleep" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border HorizontalAlignment="Right" Background="#121418" BorderBrush="#2A2E35" BorderThickness="1"
                                CornerRadius="8" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="HoldPill" Style="{StaticResource Pill}" GroupName="Mode" Content="Hold"
                                             IsChecked="True" Checked="Mode_Checked"/>
                                <RadioButton x:Name="TogglePill" Style="{StaticResource Pill}" GroupName="Mode" Content="Toggle"
                                             Checked="Mode_Checked"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button x:Name="BigButton" Width="220" Height="220" Margin="0,24,0,0" HorizontalAlignment="Center"
                            Cursor="Hand" Focusable="False" Background="#121418" BorderBrush="#FF8A3D"
                            PreviewMouseLeftButtonDown="Big_Down" PreviewMouseLeftButtonUp="Big_Up"
                            MouseLeave="Big_Leave" AutomationProperties.Name="Bleep">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="110" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel>
                            <Path x:Name="BigIcon" Width="46" Height="46" Stretch="Uniform" HorizontalAlignment="Center"
                                  Stroke="#FF8A3D" StrokeThickness="2.4" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M3,12 H6 L9,5 L15,19 L18,12 H21"/>
                            <TextBlock x:Name="BigLabel" Text="BLEEP" FontSize="26" FontWeight="Bold"
                                       Foreground="#FF8A3D" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="HintText" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="13"
                               Foreground="#A3A9B1" Text="Hold to bleep — or hold your Stream Deck key"/>

                    <TextBlock Style="{StaticResource Label}" Margin="0,24,0,6" Text="Bleep sound"/>
                    <UniformGrid Columns="3" Margin="-4,0">
                        <RadioButton Style="{StaticResource SoundBtn}" Tag="classic" Content="Classic 1 kHz" Checked="Sound_Checked"/>
                        <RadioButton Style="{StaticResource SoundBtn}" Tag="censor" Content="TV censor" Checked="Sound_Checked"/>
                        <RadioButton Style="{StaticResource SoundBtn}" Tag="dolphin" Content="Dolphin" Checked="Sound_Checked"/>
                        <RadioButton Style="{StaticResource SoundBtn}" Tag="quack" Content="Duck quack" Checked="Sound_Checked"/>
                        <RadioButton Style="{StaticResource SoundBtn}" Tag="horn" Content="Air horn" Checked="Sound_Checked"/>
                        <RadioButton x:Name="CustomRadio" Style="{StaticResource SoundBtn}" Tag="custom" Content="My .wav" Checked="Sound_Checked"/>
                    </UniformGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Style="{StaticResource LinkBtn}" Content="Choose .wav file…" Click="ChooseWav_Click"/>
                        <TextBlock x:Name="CustomText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                                   Foreground="#A3A9B1" TextTrimming="CharacterEllipsis" MaxWidth="320" Text="No file selected"/>
                    </StackPanel>

                    <Grid Margin="0,14,0,6">
                        <TextBlock FontSize="13" Foreground="#A3A9B1" Text="Bleep volume"/>
                        <TextBlock x:Name="VolumeText" HorizontalAlignment="Right" FontSize="13" Text="80%"/>
                    </Grid>
                    <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="80" SmallChange="1" LargeChange="10"
                            IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="VolumeSlider_ValueChanged"/>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
